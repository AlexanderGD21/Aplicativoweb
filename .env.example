# Copia este archivo a .env solo en tu equipo o servidor. Nunca publiques .env.
# Configuración de Django
SECRET_KEY=replace-with-a-unique-long-random-secret
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://tu-dominio.example

# Configuración de Base de Datos
# La aplicación usa únicamente PostgreSQL.
DATABASE_ENGINE=postgresql

# Para PostgreSQL
DATABASE_NAME=diccionario_kichwa
DATABASE_USER=postgres
DATABASE_PASSWORD=your_password
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_CONN_MAX_AGE=60

# Configuración de Email
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@gmail.com
EMAIL_HOST_PASSWORD=your_app_password
DEFAULT_FROM_EMAIL=no-reply@example.com
PASSWORD_RESET_TIMEOUT=86400

# Protección de acceso. Mantén 0 salvo que conozcas el número exacto de proxies
# confiables que añaden X-Forwarded-For delante de Django.
AUTH_TRUSTED_PROXY_COUNT=0

# Solo para despliegues detrás de un proxy que fija X-Forwarded-Proto de forma confiable
USE_X_FORWARDED_PROTO=False

# IA de Kichwa Unificado: desactivada de forma segura por defecto.
KICHWA_AI_PROVIDER=none
KICHWA_AI_BASE_URL=
KICHWA_AI_API_KEY=
KICHWA_AI_MODEL=
KICHWA_AI_TIMEOUT=15
